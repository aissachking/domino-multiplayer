# Copy to backend/.env (or set in your host's dashboard). Never commit real values.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed browser origins. Native mobile apps do not need this.
CORS_ORIGIN=
# Optional PostgreSQL for durable match history. Without it, history is kept in memory.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
# Apply database/migrations at startup when set to true (or run `npm run migrate`).
RUN_MIGRATIONS=false
# Gameplay timing
ABANDON_TIMEOUT_MS=60000
BOT_DELAY_MS=900
ROUND_BREAK_MS=12000
